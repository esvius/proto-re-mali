<?xml version="1.0" encoding="utf-8"?>
<!-- Prototype native port. The APK contains only the port's code and open-source libraries; the game files are
     copied by the user to /sdcard/Android/data/com.protore.game/files/game or /sdcard/Prototype (SetupActivity). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.protore.game"
    android:versionCode="1"
    android:versionName="0.1"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only for a game folder in shared storage (/sdcard/Prototype); asked for on the setup screen. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="Prototype"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:appCategory="game"
        android:requestLegacyExternalStorage="true"
        android:isGame="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- profiling with simpleperf without root -->
        <profileable android:shell="true" />

        <activity
            android:name="com.protore.game.SetupActivity"
            android:label="Prototype"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.protore.game.ProtoActivity"
            android:label="Prototype"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true" />
    </application>
</manifest>
