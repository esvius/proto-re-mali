+  bool Presenter::suboptimalIsHarmless() {
+    // Ask the surface for its size only every few frames, this is a
+    // query into the window system. A real resize or rotation also
+    // produces VK_ERROR_OUT_OF_DATE_KHR, which is handled as before.
+    if ((m_suboptimalCounter++ % 16u) != 0u)
+      return true;
+
+    VkSurfaceCapabilitiesKHR caps = { };
+
+    VkResult vr = m_vki->vkGetPhysicalDeviceSurfaceCapabilitiesKHR(
+      m_device->adapter()->handle(), m_surface, &caps);
+
+    if (vr != VK_SUCCESS)
+      return false;
+
+    if (caps.currentExtent.width == std::numeric_limits<uint32_t>::max())
+      return true;
+
+    return caps.currentExtent.width  == m_swapchainExtent.width
+        && caps.currentExtent.height == m_swapchainExtent.height;
+  }
+
