+  void DxvkSwapchainBlitter::copyFrame(
+    const DxvkContextObjects& ctx,
+    const Rc<DxvkImageView>&  srcView,
+    const Rc<DxvkImage>&      dstImage) {
+    const Rc<DxvkImage>& srcImage = srcView->image();
+
+    std::array<VkImageMemoryBarrier2, 2> barriers = { };
+
+    // Source: from its usual layout to transfer source
+    barriers[0].sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2;
+    barriers[0].srcStageMask = srcImage->info().stages;
+    barriers[0].srcAccessMask = srcImage->info().access;
+    barriers[0].dstStageMask = VK_PIPELINE_STAGE_TRANSFER_BIT;
+    barriers[0].dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    barriers[0].oldLayout = srcImage->info().layout;
+    barriers[0].newLayout = srcImage->pickLayout(VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    barriers[0].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barriers[0].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barriers[0].image = srcImage->handle();
+    barriers[0].subresourceRange = srcView->imageSubresources();
+
+    // Destination: the old contents are replaced completely
+    barriers[1].sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2;
+    barriers[1].srcStageMask = dstImage->info().stages;
+    barriers[1].srcAccessMask = dstImage->info().access;
+    barriers[1].dstStageMask = VK_PIPELINE_STAGE_TRANSFER_BIT;
+    barriers[1].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    barriers[1].oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    barriers[1].newLayout = dstImage->pickLayout(VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    barriers[1].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barriers[1].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barriers[1].image = dstImage->handle();
+    barriers[1].subresourceRange = dstImage->getAvailableSubresources();
+
+    VkDependencyInfo depInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    depInfo.imageMemoryBarrierCount = barriers.size();
+    depInfo.pImageMemoryBarriers = barriers.data();
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+    dstImage->trackInitialization(barriers[1].subresourceRange);
+
+    VkImageCopy2 region = { VK_STRUCTURE_TYPE_IMAGE_COPY_2 };
+    region.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 0u, 1u };
+    region.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 0u, 1u };
+    region.extent = dstImage->info().extent;
+
+    VkCopyImageInfo2 copy = { VK_STRUCTURE_TYPE_COPY_IMAGE_INFO_2 };
+    copy.srcImage = srcImage->handle();
+    copy.srcImageLayout = barriers[0].newLayout;
+    copy.dstImage = dstImage->handle();
+    copy.dstImageLayout = barriers[1].newLayout;
+    copy.regionCount = 1;
+    copy.pRegions = &region;
+
+    ctx.cmd->cmdCopyImage(DxvkCmdBuffer::ExecBuffer, &copy);
+
+    // Both images back to their usual layouts
+    for (auto& barrier : barriers) {
+      barrier.srcStageMask = VK_PIPELINE_STAGE_TRANSFER_BIT;
+      barrier.srcAccessMask = barrier.dstAccessMask;
+      barrier.oldLayout = barrier.newLayout;
+    }
+
+    barriers[0].dstStageMask = srcImage->info().stages;
+    barriers[0].dstAccessMask = srcImage->info().access;
+    barriers[0].newLayout = srcImage->info().layout;
+
+    barriers[1].dstStageMask = dstImage->info().stages;
+    barriers[1].dstAccessMask = dstImage->info().access;
+    barriers[1].newLayout = dstImage->info().layout;
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+    ctx.cmd->track(srcImage, DxvkAccess::Read);
+    ctx.cmd->track(dstImage, DxvkAccess::Write);
   }
 
 
