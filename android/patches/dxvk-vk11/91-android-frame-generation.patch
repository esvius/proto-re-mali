+#ifdef __ANDROID__
+  // frame_gen = 1 in protore.ini (or PROTORE_FRAME_GEN=1 in the environment)
+  static bool ReadFrameGenSetting() {
+    if (const char* env = std::getenv("PROTORE_FRAME_GEN"))
+      return std::atoi(env) != 0;
+
+    const char* dir = std::getenv("DXVK_STATE_CACHE_PATH");
+
+    if (!dir || !*dir)
+      return false;
+
+    std::ifstream file(std::string(dir) + "/protore.ini");
+    std::string line;
+
+    while (std::getline(file, line)) {
+      size_t eq = line.find('=');
+
+      if (eq == std::string::npos || line[0] == '#')
+        continue;
+
+      auto trim = [] (std::string s) {
+        size_t a = s.find_first_not_of(" \t\r\n");
+        size_t b = s.find_last_not_of(" \t\r\n");
+        return a == std::string::npos ? std::string() : s.substr(a, b - a + 1);
+      };
+
+      if (trim(line.substr(0, eq)) == "frame_gen")
+        return std::atoi(trim(line.substr(eq + 1)).c_str()) != 0;
+    }
+
+    return false;
+  }
+#endif
