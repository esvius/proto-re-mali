+    // Create and assign actual buffer resource. A failed allocation throws (D3D9 turns that into an error code)
+    // instead of dereferencing a null storage; the allocator must not keep a pointer to the half-built buffer.
+    Rc<DxvkResourceAllocation> storage = allocateStorage();
+
+    if (unlikely(!storage)) {
+      m_allocator->unregisterResource(this);
+      throw DxvkError(str::format("DxvkBuffer: Failed to create buffer, size ", createInfo.size,
