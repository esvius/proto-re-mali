+++ b/src/wsi/sdl2/wsi_window_sdl2.cpp
@@ -10,6 +10,10 @@
 
 #include <windows.h>
 #include <SDL_vulkan.h>
+#ifdef __ANDROID__
+#include <android/native_window.h>
+#include <vulkan/vulkan_android.h>
+#endif
 
 namespace dxvk::wsi {
 
@@ -163,9 +167,26 @@ namespace dxvk::wsi {
           VkSurfaceKHR*             pSurface) {
     SDL_Window* window = fromHwnd(hWindow);
 
+#ifdef __ANDROID__
+    // Android port: create the surface through the instance's own vkGetInstanceProcAddr. The Vulkan library may
+    // be a bundled driver (Turnip, loaded by the host through adrenotools) that SDL knows nothing about; and a
+    // window whose surface Android has destroyed yields an error instead of a crash in the loader.
+    SDL_SysWMinfo info;
+    SDL_VERSION(&info.version);
+    if (!SDL_GetWindowWMInfo(window, &info) || !info.info.android.window)
+      return VK_ERROR_SURFACE_LOST_KHR;
+    auto create = reinterpret_cast<PFN_vkCreateAndroidSurfaceKHR>(
+      pfnVkGetInstanceProcAddr(instance, "vkCreateAndroidSurfaceKHR"));
+    if (!create)
+      return VK_ERROR_EXTENSION_NOT_PRESENT;
+    VkAndroidSurfaceCreateInfoKHR ci = { VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR };
+    ci.window = info.info.android.window;
+    return create(instance, &ci, nullptr, pSurface);
+#else
     return SDL_Vulkan_CreateSurface(window, instance, pSurface)
          ? VK_SUCCESS
          : VK_ERROR_OUT_OF_HOST_MEMORY;
+#endif
   }
 
 }
