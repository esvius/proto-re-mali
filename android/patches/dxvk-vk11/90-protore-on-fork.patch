+  // Android port: report every missing feature instead of failing silently.
+  static bool checkFeatureNeed(VkBool32 have, VkBool32 need, const char* name) {
+    if (need && !have)
+      Logger::err(str::format("DxvkAdapter: missing required feature ", name));
+    return have || !need;
+  }
+
 #define CHECK_FEATURE_NEED(feature) \
-  (m_deviceFeatures.feature         \
-       || !required.feature)
+  checkFeatureNeed(m_deviceFeatures.feature, required.feature, #feature)
+
+
+  // Android port: drivers (Mali) reject features DXVK enables without checking support; turn each such feature
+  // off and report it instead of failing device creation with VK_ERROR_FEATURE_NOT_PRESENT.
+  template<typename T>
+  static void clampFeatures(T& enabled, const T& supported, const char* name) {
+    constexpr size_t header = 16;  // sType + pNext
+    auto* e = reinterpret_cast<VkBool32*>(reinterpret_cast<char*>(&enabled) + header);
+    auto* s = reinterpret_cast<const VkBool32*>(reinterpret_cast<const char*>(&supported) + header);
+    for (size_t i = 0; i < (sizeof(T) - header) / sizeof(VkBool32); i++) {
+      if (e[i] && !s[i]) {
+        Logger::warn(str::format("DxvkAdapter: ", name, " feature #", i, " not supported, disabled"));
+        e[i] = VK_FALSE;
+      }
+    }
+  }
 
