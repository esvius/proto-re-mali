+  VkImageView DxvkUnboundResources::imageViewHandle(DxvkContext* ctx, VkImageViewType type) {
+    VkImageView view = m_viewHandles[type].load();
+
+    if (likely(view != VK_NULL_HANDLE))
+      return view;
+
+    std::lock_guard lock(m_mutex);
+    view = m_viewHandles[type].load();
+
+    if (view)
+      return view;
+
+    uint32_t family = (type == VK_IMAGE_VIEW_TYPE_1D || type == VK_IMAGE_VIEW_TYPE_1D_ARRAY) ? 0u
+                    : (type == VK_IMAGE_VIEW_TYPE_3D) ? 2u : 1u;
+
+    if (m_images[family] == nullptr) {
+      Logger::info(str::format("DxvkUnboundResources: no null descriptors, dummy image for view type ", type));
+
+      DxvkImageCreateInfo info;
+      info.type        = family == 0u ? VK_IMAGE_TYPE_1D : family == 2u ? VK_IMAGE_TYPE_3D : VK_IMAGE_TYPE_2D;
