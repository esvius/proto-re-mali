+      info.flags       = family == 1u ? VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT : 0u;
+      info.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+      info.extent      = { 1u, 1u, 1u };
+      info.numLayers   = family == 1u ? 6u : 1u;
+      info.mipLevels   = 1u;
+      info.usage       = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+      info.stages      = VK_PIPELINE_STAGE_TRANSFER_BIT | m_device->getShaderPipelineStages();
+      info.access      = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+      info.layout      = VK_IMAGE_LAYOUT_GENERAL;
+      info.debugName   = "Null image";
+
+      m_images[family] = m_device->createImage(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+
+      DxvkImageViewKey key;
+      key.viewType   = family == 0u ? VK_IMAGE_VIEW_TYPE_1D_ARRAY
+                     : family == 2u ? VK_IMAGE_VIEW_TYPE_3D : VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+      key.usage      = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT;
+      key.format     = info.format;
+      key.aspects    = VK_IMAGE_ASPECT_COLOR_BIT;
+      key.mipIndex   = 0u;
+      key.mipCount   = 1u;
+      key.layerIndex = 0u;
+      key.layerCount = uint16_t(info.numLayers);
+      m_imageViews[family] = m_images[family]->createView(key);
+
+      VkImageSubresourceRange range = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, info.numLayers };
